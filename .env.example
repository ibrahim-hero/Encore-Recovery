# Leave everything blank to run locally with PGlite and the fixture PayPal provider.

# fixture | sandbox
APP_MODE=fixture

# local | vercel | render (fixture mode is rejected on render)
DEPLOYMENT_TARGET=

# Public origin used for webhooks and PayPal return URLs
APP_ORIGIN=

# Postgres (Neon). When unset, in-process PGlite is used.
DATABASE_URL=
PGLITE_DIR=

# PayPal Sandbox REST app and the expected merchant (payee) id
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
# Optional: US Business sandbox account, overrides the three above when set
PAYPAL_US_CLIENT_ID=
PAYPAL_US_CLIENT_SECRET=
PAYPAL_US_MERCHANT_ID=
# Webhook id from the PayPal Sandbox app, used to verify signatures
PAYPAL_WEBHOOK_ID=

# AI Gateway model ids (zero-config on Vercel)
AI_MODEL=openai/gpt-5-mini
AI_FALLBACK_MODELS=google/gemini-2.5-flash

# Protects POST /api/internal/jobs/drain
INTERNAL_JOB_TOKEN=

# Fixture provider: simulated refund settle delay in ms
FIXTURE_REFUND_COMPLETE_MS=4000

# AG Studio license
AG_STUDIO_LICENSE_KEY=
